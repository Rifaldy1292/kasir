# Server Configuration
PORT=8181

# PostgreSQL Database URL (Neon, Supabase, atau PostgreSQL lokal)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Wajib diisi dengan string acak yang panjang — jangan gunakan nilai contoh ini di production
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang

# Google Gemini AI Configuration (opsional, untuk fitur AI prediction/chat)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
